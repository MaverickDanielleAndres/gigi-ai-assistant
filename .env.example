# Keep API keys, Redis credentials, and the signing secret server-side. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
# This site key is intentionally public so the browser can render the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SESSION_SIGNING_SECRET=

# Required before public deployment; local development can run without it.
PUBLIC_DEMO_ENABLED=false
# Set to your canonical public HTTPS origin when you have a domain.
NEXT_PUBLIC_SITE_URL=
DAILY_GLOBAL_REQUEST_CAP=150
DAILY_SESSION_REQUEST_CAP=8
